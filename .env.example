# --- SMTP settings for the contact form (app/api/contact) ---
# Without these, the form returns a graceful "not configured" message
# and users are asked to email info@teparmis.ir directly.

SMTP_HOST=mail.teparmis.ir
SMTP_PORT=587
SMTP_USER=info@teparmis.ir
SMTP_PASS=your-mailbox-password

# Where contact messages are delivered (defaults to info@teparmis.ir)
CONTACT_TO=info@teparmis.ir
# The "from" address used to send (defaults to SMTP_USER)
CONTACT_FROM=info@teparmis.ir
